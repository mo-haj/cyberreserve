  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "15.5.29",
    "prisma": "5.22.0",
    "qrcode-generator": "2.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.33"
  }
