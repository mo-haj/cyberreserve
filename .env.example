# CyberReserve environment. Copy to .env and fill in, or run scripts/setup-env.sh
# (Windows: scripts/setup-env.ps1) to generate a .env with random secrets.
# .env is git-ignored. Never commit it.

# Database
# Use only letters and digits in the password, or URL-encode it inside DATABASE_URL.
POSTGRES_USER=cyberreserve
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=cyberreserve
# Host is "postgres" (the compose service name). Must repeat the user/password/db above.
DATABASE_URL=postgresql://cyberreserve:CHANGE_ME@postgres:5432/cyberreserve?schema=public

# Site owner (super admin) of the dashboard at /admin: Telegram account ID(s), comma-separated.
# Get your ID from @userinfobot in Telegram (the "Id" number). Empty = nobody is super admin.
ADMIN_TELEGRAM_IDS=

# Host interface the web port (3000) is published on.
# 127.0.0.1 = reachable only from the server itself (correct with a cloudflared tunnel).
# Do NOT set 0.0.0.0 in production: it exposes the server directly.
WEB_BIND=127.0.0.1

# Cloudflare Tunnel (production). Token from Zero Trust > Networks > Tunnels.
# Used only when started with: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Local ping agent (Phase 3)
AGENT_KEY=

# Telegram — players sign in with Telegram (see README, "Telegram sign-in").
# Empty token = the Sign in page says sign-in is not set up yet.
# Token and username come from @BotFather. Keep the token secret.
TELEGRAM_BOT_TOKEN=
# Bot username without @, e.g. CyberReserveBot
TELEGRAM_BOT_USERNAME=
# Random string (letters/digits). Used in the webhook path AND checked in the
# X-Telegram-Bot-Api-Secret-Token header. setup-env generates one.
TELEGRAM_WEBHOOK_SECRET=
# Shown on the Terms and Privacy pages as the contact for questions and
# account deletion (email, phone or @username). Empty = the bot's @username.
SUPPORT_CONTACT=
# Owner alerts (Phase 4)
TELEGRAM_ADMIN_CHAT_ID=

# Backups
BACKUP_RETENTION_DAYS=7

# Demo content. The 3 demo cafes are always seeded (marked "Demo cafe" on the
# site). This switch controls the demo bookings that make some PCs show red.
# Set to false once real cafes and real bookings exist.
SEED_DEMO_BOOKINGS=true

# DEVELOPMENT ONLY: serve demo cafes without a database (page previews).
# Never set this in production.
# DEV_FIXTURE_DATA=1

# ---- Hosting on Vercel + Neon (instead of Docker) — set these in Vercel, not here ----
# DATABASE_URL = Neon's POOLED address (host has "-pooler"), ending with ?sslmode=require&pgbouncer=true
# DIRECT_URL   = Neon's direct address (no "-pooler"), used only to update the database at deploy time
# CRON_SECRET  = a long random string; cron-job.org calls /api/cron/tick?key=<CRON_SECRET> every minute
# PUBLIC_URL   = optional: the site's address for the Telegram bot (default: Vercel's production domain)
